FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV ASR_ENGINE=granite
ENV ASR_PORT=8765
ENV OMP_NUM_THREADS=2
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1
# Smart Turn ONNX cache (downloaded on first start, persisted via the
# /models volume so restarts don't re-download).
ENV HF_HOME=/models/hf

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/asr/requirements-granite.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/requirements.txt

COPY services/asr/app /app/app

EXPOSE 8765

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8765", "--workers", "1"]