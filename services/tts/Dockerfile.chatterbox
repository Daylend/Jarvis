ARG BASE_IMAGE=rocm/pytorch:latest
FROM ${BASE_IMAGE}

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/hf
ENV TORCH_HOME=/models/torch
ENV TTS_PORT=8860
ENV TTS_ENGINE=chatterbox
ENV TTS_REF_AUDIO=/app/voice_samples/ultron.mp3
ENV OMP_NUM_THREADS=2

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Path A (default). If step-0 pre-flight shows no gfx1201 kernels, switch the index-url
# to a newer ROCm line (7.1/7.2) + matching torch, and keep chatterbox-tts --no-deps.
RUN python -m pip install --upgrade pip wheel setuptools \
 && pip install --no-cache-dir torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
      --index-url https://download.pytorch.org/whl/rocm6.2.4 \
 && pip install --no-cache-dir --no-deps chatterbox-tts==0.1.7 \
 && pip install --no-cache-dir \
      "transformers==5.2.0" "diffusers==0.29.0" "librosa==0.11.0" s3tokenizer \
      "safetensors==0.5.3" "conformer==0.3.2" pyloudnorm omegaconf \
      "git+https://github.com/resemble-ai/Perth.git@master" \
      fastapi "uvicorn[standard]" pydantic numpy

COPY voice_samples/ultron.mp3 /app/voice_samples/ultron.mp3
COPY services/tts/app /app/app
RUN mkdir -p /app/data /models/hf /models/torch && chmod -R 777 /app/data /models

EXPOSE 8860

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=600s \
    CMD curl -f http://localhost:8860/healthz || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8860", "--workers", "1"]
