ARG BASE_IMAGE=rocm/pytorch:rocm6.4.2_ubuntu22.04_py3.10_pytorch_release_2.6.0
FROM ${BASE_IMAGE}

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/hf
ENV TORCH_HOME=/models/torch
ENV TTS_PORT=8860
ENV TTS_ENGINE=chatterbox
ENV TTS_REF_AUDIO=/app/voice_samples/ultron.mp3
ENV OMP_NUM_THREADS=2

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Install ROCm 6.4.2 pre-installed stack matching packages.
# We explicitly avoid reinstalling/upgrading torch, torchaudio, or torchvision to protect
# the AMD pre-built binaries. We install Chatterbox dependencies separately.
RUN python3 -m pip install --upgrade pip wheel setuptools \
 && python3 -m pip install --no-cache-dir \
      "numpy>=1.24.0,<2.0.0" \
      librosa==0.11.0 \
      s3tokenizer \
      transformers==5.2.0 \
      diffusers==0.29.0 \
      "resemble-perth>=1.0.0" \
      conformer==0.3.2 \
      safetensors==0.5.3 \
      spacy-pkuseg \
      pykakasi==2.3.0 \
      gradio==6.8.0 \
      pyloudnorm \
      omegaconf \
 && python3 -m pip install --no-cache-dir --no-deps \
      --index-url https://download.pytorch.org/whl/cpu \
      "torchcodec==0.2.*" \
 && python3 -m pip install --no-cache-dir --no-deps chatterbox-tts==0.1.7

COPY voice_samples/ultron.mp3 /app/voice_samples/ultron.mp3
COPY services/tts/app /app/app
RUN mkdir -p /app/data /models/hf /models/torch && chmod -R 777 /app/data /models

EXPOSE 8860

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=600s \
    CMD curl -f http://localhost:8860/healthz || exit 1

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8860", "--workers", "1"]
