# dots.tts engine sidecar — built for AMD gfx1201 (Radeon R9700 AI Pro).
#
# Why this base and not rocm/pytorch (like the F5/Chatterbox Dockerfiles):
# gfx1201 needs ROCm 7.x. The rocm/pytorch bases max out at torch 2.9.1 on
# ROCm 7.2, but the pytorch.org rocm7.2 wheel index ships torchaudio ONLY at
# 2.11.0 (which requires torch 2.11.0) — so there is no torch/torchaudio matched
# pair that can be overlaid onto a 2.9.1 conda base. The clean path is the same
# bare ROCm dev base the llama.cpp sidecar uses (rocm/dev-ubuntu-24.04:7.2.1-complete,
# proven working on this GPU) with a fresh matched pip pair from the rocm7.2 index:
#   torch 2.11.0+rocm7.2 + torchaudio 2.11.0+rocm7.2 (+ triton-rocm 3.6.0)
# Installing both from one index with no conda torch underneath avoids the
# libtorch_hip.so "cannot open shared object file" failure that occurs when
# pip torch is overlaid on a mismatched conda torch.
#
# dots.tts declares torch>=2.8.0 / torchaudio>=2.8.0, so 2.11.0 satisfies it.
ARG BASE_IMAGE=rocm/dev-ubuntu-24.04:7.2.1-complete
FROM ${BASE_IMAGE}

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/hf
ENV TORCH_HOME=/models/torch
# torch/lib .so files link the ROCm runtime libs (libMIOpen, libhipblas, ...);
# the dev base does not set LD_LIBRARY_PATH, so point it at /opt/rocm/lib.
ENV LD_LIBRARY_PATH=/opt/rocm/lib
ENV TTS_DEVICE=cuda:0
ENV TTS_PORT=8860
ENV TTS_ENGINE=dots
ENV TTS_REF_AUDIO=/app/voice_samples/reference.wav
# dots.tts defaults — see services/tts/app/config.py for the full set + docs.
ENV DOTS_MODEL=rednote-hilab/dots.tts-mf
ENV DOTS_NUM_STEPS=4
ENV DOTS_GUIDANCE_SCALE=1.2
ENV DOTS_OPTIMIZE=false
ENV DOTS_NORMALIZE_TEXT=false
ENV OMP_NUM_THREADS=2
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1
# Vendored dots_tts package lives at /app/vendor/dots_tts; expose via PYTHONPATH
# instead of pip-installing (the vendored dir has no build metadata by design).
ENV PYTHONPATH=/app/vendor
# MIOpen solver selection for gfx1201 (RDNA 4 / R9700 AI Pro).
# HYBRID checks existing DB entries first, otherwise performs a full search —
# the default DYNAMIC_HYBRID mode can skip non-dynamic convolution candidates,
# which on this stack biases the BigVGAN decoder convs toward the slow
# GemmFwdRest (im2col + rocBLAS GEMM) path. The persistent paths survive
# container restarts and retain both the selected solver database and the
# JIT-compiled device kernels. Set MIOPEN_TUNE=1 only for a deliberate
# warm-up/tuning run (see docker/entrypoint.dots.sh).
ENV MIOPEN_FIND_MODE=HYBRID
ENV MIOPEN_USER_DB_PATH=/models/miopen/userdb
ENV MIOPEN_CUSTOM_CACHE_DIR=/models/miopen/kernel-cache
ENV MIOPEN_TUNE=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git ca-certificates curl python3-pip python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

COPY services/tts/constraints.dots.txt /app/constraints.dots.txt
# Vendor the dots_tts package source (copied from upstream src/dots_tts).
COPY services/tts/vendor/dots_tts /app/vendor/dots_tts

# 1) torch 2.11.0 + torchaudio 2.11.0 from the rocm7.2 index. No --no-deps:
#    this also pulls torch's own deps (triton-rocm==3.6.0, typing_extensions,
#    sympy, networkx, jinja2, fsspec, filelock) which only exist on this index.
# 2) dots.tts transitive deps from PyPI + rocm7.2 as extra-index. The
#    constraints file freezes torch/torchaudio so pip can't "upgrade" torch to a
#    CUDA build from PyPI (which would silently replace the ROCm stack).
#    WeTextProcessing (tn) is mandatory: dots_tts.utils.text imports it at
#    module top level, pulled in unconditionally at runtime load.
#    torchcodec/torchvision are NOT imported by dots.tts and are omitted.
# 3) fastapi sidecar deps (not part of dots_tts).
#    The dots_tts package itself is NOT pip-installed — it is vendored under
#    /app/vendor/dots_tts and exposed via PYTHONPATH (see ENV above), avoiding
#    its pyproject's gradio hard-dep and torch>=2.8 resolver fight.
RUN pip3 install --no-cache-dir --break-system-packages \
        --index-url https://download.pytorch.org/whl/rocm7.2 \
        torch==2.11.0 torchaudio==2.11.0 \
    && pip3 install --no-cache-dir --break-system-packages \
        --extra-index-url https://download.pytorch.org/whl/rocm7.2 \
        -c /app/constraints.dots.txt \
        einops \
        huggingface-hub \
        "langcodes[data]" \
        "librosa==0.11.0" \
        lingua-language-detector \
        loguru \
        "numpy==2.2.6" \
        "pydantic==2.12.5" \
        "PyYAML==6.0.3" \
        "safetensors==0.8.0rc0" \
        "soundfile==0.13.1" \
        "transformers==4.57.0" \
        torchdiffeq \
        WeTextProcessing \
        fastapi \
        "uvicorn[standard]"

# Reference audio (TTS_REF_AUDIO) is mounted into /app/voice_samples at runtime,
# or pointed at any path via the env var. 
COPY services/tts/app /app/app

RUN mkdir -p \
        /app/data \
        /models/hf \
        /models/torch \
        /models/miopen/userdb \
        /models/miopen/kernel-cache \
    && chmod -R 777 /app/data /models

COPY services/tts/docker/entrypoint.dots.sh /app/entrypoint.dots.sh
RUN chmod 0755 /app/entrypoint.dots.sh

EXPOSE 8860

# dots.tts checkpoints are ~2B params (~5GB bf16 + VAE). The first-run HF
# snapshot_download is much larger than F5/Chatterbox; keep a generous start
# period (or pre-download the model in-image via huggingface-cli for a deploy).
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=900s \
    CMD curl -f http://localhost:8860/healthz || exit 1

ENTRYPOINT ["/app/entrypoint.dots.sh"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8860", "--workers", "1"]
