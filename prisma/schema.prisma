generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Quote {
  id        Int      @id @default(autoincrement())
  text      String
  type      String   @default("funny") // "funny" or "angry"
  addedBy   String?
  createdAt DateTime @default(now())
}

model AIProvider {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  model     String
  addedBy   String?
  createdAt DateTime @default(now())
}

model VoiceSession {
  id          String       @id @default(cuid())
  guildId     String
  channelId   String
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  startedBy   String
  transcripts Transcript[]

  @@index([guildId, startedAt])
}

model Transcript {
  id             Int          @id @default(autoincrement())
  sessionId      String
  session        VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guildId        String
  channelId      String
  userId         String
  startMs        Int
  endMs          Int
  textRaw        String
  textNormalized String
  confidence     Float?
  createdAt      DateTime     @default(now())

  @@index([sessionId, startMs])
  @@index([userId, createdAt])
  @@index([channelId, createdAt])
  @@index([guildId, createdAt])
}

model Note {
  id        Int      @id @default(autoincrement())
  guildId   String
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

model TermAlias {
  id        Int      @id @default(autoincrement())
  canonical String
  alias     String
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([canonical, alias], name: "canonical_alias")
  @@index([alias])
}
